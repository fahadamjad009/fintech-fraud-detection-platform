# Copy to .env and fill in for local development.
# Nothing here is required for the current pipeline — placeholders for future extensions.

# Model artifact paths (defaults work if you keep the repo layout)
MODEL_DIR=models
REPORTS_DIR=reports

# FastAPI scoring service
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit dashboard
STREAMLIT_SERVER_PORT=8501

# Logging
LOG_LEVEL=INFO
